{
  "manifest_version": 3,
  "name": "TabPrint",
  "version": "6.11.703",
  "version_name": "6.11.0703",
  "description": "Pick tabs and print them to PDF in one click.",
  "permissions": ["tabs", "debugger", "downloads", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "TabPrint",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  }
}
